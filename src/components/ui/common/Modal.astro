---
/*
 * Modal accesible.
 * - Abrir: botón con `data-modal-open="<id>"` o evento `modal:show:<id>` en `window`.
 * - Cerrar: `data-modal-close` dentro del modal, clic en el overlay, Escape o evento `modal:hide:<id>`.
 * - Foco inicial: elemento con `data-modal-autofocus` (si no hay, el propio modal).
 * - Requiere un elemento con id `<id>-title` (lo usa `aria-labelledby`).
 * - Estados (`data-state`): closed → opening → open → closing → closed.
 */

interface Props {
    id: string;
    class?: string;
    overlayColor?: string;
    /** Espacio entre el panel y el borde de la pantalla (se aplica como `padding`). */
    offset?: string;
    verticalPosition?: 'top' | 'center' | 'bottom';
    /** Quita el modal del DOM mientras está cerrado. @default false */
    unmount?: boolean;
};

const { id, class: className, overlayColor, offset, verticalPosition = 'center', unmount = false } = Astro.props;
---

<div id={id} class:list={["modal", className]} data-modal-id={id} data-state="closed" data-vertical={verticalPosition} data-unmount={String(unmount)} aria-labelledby={`${id}-title`} tabindex="-1" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="modal-overlay" style={overlayColor && `--overlay-color: ${overlayColor};`}></div>
    <div class="modal-wrapper">
        <div class="modal-positioner" style={offset && `--offset: ${offset};`}>
            <div class="modal-panel">
                <slot/>
            </div>
        </div>
    </div>
</div>

<style>
.modal {
    display: none;
    position: relative;
    z-index: 50;
}

.modal:not([data-state="closed"]) {
    display: block;
}

/*
 * Sin `backdrop-filter`: el desenfoque obliga a re-rasterizar toda la pantalla
 * en cada frame de la transición de opacidad (principal causa de "dropped frames").
 */
.modal-overlay {
    position: fixed;
    inset: 0px;
    opacity: 0;
    background-color: var(--overlay-color);
    transition: opacity var(--transition-duration, 300ms) var(--transition-timing, ease-in-out);
}

.modal[data-state="open"] > .modal-overlay { opacity: 1; }

/* No captura clics: así llegan al overlay y solo el panel los recibe. */
.modal-wrapper {
    position: fixed;
    inset: 0px;
    z-index: 50;
    overflow-y: auto;
    overscroll-behavior: contain;
    pointer-events: none;
}

.modal-positioner {
    display: flex;
    justify-content: center;
    align-items: var(--align-items);
    padding: var(--offset);
    min-height: 100%;
}

.modal[data-vertical="top"] .modal-positioner { --align-items: flex-start; }
.modal[data-vertical="center"] .modal-positioner { --align-items: center; }
.modal[data-vertical="bottom"] .modal-positioner { --align-items: flex-end; }

.modal-panel {
    pointer-events: auto;
    opacity: 0;
    transform: translateY(10px) scale(75%);
    transition:
        opacity var(--transition-duration, 300ms) var(--transition-timing, ease-in-out),
        transform var(--transition-duration, 300ms) var(--transition-timing, ease-in-out);
}

/* `transform: none` al final: no deja un transform "identidad" que cree un containing block
   para hijos `position: fixed` ni una capa de composición permanente (texto borroso). */
.modal[data-state="open"] .modal-panel {
    opacity: 1;
    transform: none;
}

@media (prefers-reduced-motion: reduce) {
    .modal-overlay,
    .modal-panel {
        transition: none;
    }
}
</style>

<script>
    import { appendChildElement, removeElement, trapFocus } from '../utils/overlay';
    import type { ChangeDetail } from './types.ts';

    // Un único listener global para todos los botones `data-modal-open` (también los añadidos después).
    // Reutiliza el evento `modal:show:<id>` y le pasa el botón para devolverle el foco al cerrar
    // (Safari y Firefox en macOS no enfocan los botones al hacer clic).
    document.addEventListener('click', (event) => {
        const trigger = (event.target as Element | null)?.closest<HTMLElement>('[data-modal-open]');
        const id = trigger?.dataset.modalOpen;
        if (id) window.dispatchEvent(new CustomEvent(`modal:show:${id}`, { detail: { trigger } }));
    });

    const setupModal = (modalElement: HTMLDivElement) => {
        if (modalElement.dataset.modalReady) return;

        const { modalId, unmount } = modalElement.dataset;
        if (!modalId) throw new Error('Missing "data-modal-id" attribute on Modal component');

        const overlayElement = modalElement.querySelector<HTMLDivElement>('.modal-overlay');
        const panelElement = modalElement.querySelector<HTMLDivElement>('.modal-panel');
        if (!overlayElement || !panelElement) throw new Error(`Modal "${modalId}": component internal element(s) not found.`);

        modalElement.dataset.modalReady = 'true';

        const shouldUnmount = unmount === 'true';

        // Todos los listeners de `window` se retiran al cambiar de página con ClientRouter (view transitions).
        // Si usas `transition:persist` en un modal, elimina este bloque.
        const controller = new AbortController();
        const { signal } = controller;
        document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });

        if (shouldUnmount) removeElement(modalElement);
        else if (modalElement.parentElement !== document.body) appendChildElement(modalElement);

        let lastFocusedElement: HTMLElement | null = null;
        // Se incrementa con cada orden de abrir/cerrar: invalida las operaciones asíncronas anteriores.
        let token = 0;

        const setOpen = (isOpen: boolean) => {
            modalElement.dataset.state = isOpen ? 'open' : 'closed';
            modalElement.setAttribute('aria-hidden', String(!isOpen));
            document
                .querySelectorAll(`[data-modal-open="${CSS.escape(modalId)}"]`)
                .forEach((opener) => opener.setAttribute('aria-expanded', String(isOpen)));

            const detail: ChangeDetail = { isOpen };
            modalElement.dispatchEvent(new CustomEvent('modal:change', { detail }));
            window.dispatchEvent(new CustomEvent(`modal:change:${modalId}`, { detail }));
        };

        const handleKeyboard = (event: KeyboardEvent) => {
            if (event.key === 'Escape') return hideModal();
            if (event.key === 'Tab') trapFocus(modalElement, event);
        };

        const commitOpen = () => {
            setOpen(true);
            modalElement.addEventListener('keydown', handleKeyboard);
            (modalElement.querySelector<HTMLElement>('[data-modal-autofocus]') ?? modalElement).focus({ preventScroll: true });
        };

        const showModal = (event?: Event) => {
            const state = modalElement.dataset.state;
            if (state === 'open' || state === 'opening') return;

            const current = ++token;

            // Se reabre mientras cerraba: la transición simplemente se invierte.
            if (state === 'closing') return commitOpen();

            const trigger = (event as CustomEvent<{ trigger?: HTMLElement }> | undefined)?.detail?.trigger;
            // Se guarda antes de abrir, para restaurarlo al cerrar.
            lastFocusedElement = trigger ?? (document.activeElement as HTMLElement | null);

            if (shouldUnmount) appendChildElement(modalElement);
            modalElement.dataset.state = 'opening';

            // Dos frames: el primero pinta el estado inicial (opacity 0) y el segundo lanza la transición.
            // Sustituye al `offsetHeight`, que forzaba un reflow síncrono.
            requestAnimationFrame(() =>
                requestAnimationFrame(() => {
                    if (current === token) commitOpen();
                })
            );
        };

        const hideModal = () => {
            const state = modalElement.dataset.state;
            if (state !== 'open' && state !== 'opening') return;

            const current = ++token;
            modalElement.removeEventListener('keydown', handleKeyboard);

            // Aún no se había confirmado la apertura: se cancela sin animar.
            if (state === 'opening') {
                modalElement.dataset.state = 'closed';
                if (shouldUnmount) removeElement(modalElement);
                return;
            }

            // El foco sale antes de marcar aria-hidden="true".
            lastFocusedElement?.focus({ preventScroll: true });
            modalElement.dataset.state = 'closing';

            // Solo las transiciones propias (overlay y panel): una animación infinita del contenido
            // (p. ej. un spinner) dejaría el modal sin cerrarse. Resuelve al instante si no hay ninguna.
            const animations = [...overlayElement.getAnimations(), ...panelElement.getAnimations()];

            Promise.allSettled(animations.map(({ finished }) => finished)).then(() => {
                if (current !== token) return; // se volvió a abrir mientras cerraba
                setOpen(false);
                if (shouldUnmount) removeElement(modalElement);
            });
        };

        overlayElement.addEventListener('click', hideModal, { signal });
        modalElement.addEventListener(
            'click',
            (event) => {
                if ((event.target as Element | null)?.closest('[data-modal-close]')) hideModal();
            },
            { signal }
        );
        window.addEventListener(`modal:show:${modalId}`, showModal, { signal });
        window.addEventListener(`modal:hide:${modalId}`, hideModal, { signal });
    };

    const init = () => document.querySelectorAll<HTMLDivElement>('.modal').forEach(setupModal);

    init();
    // Con ClientRouter se vuelve a ejecutar en cada navegación; `data-modal-ready` evita inicializar dos veces.
    document.addEventListener('astro:page-load', init);
</script>