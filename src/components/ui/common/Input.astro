---
import './styles.css';
import ToggleButton from './ToggleButton.astro';

interface Props extends astroHTML.JSX.InputHTMLAttributes {
    id: string;
    class?: string;
    label?: {
        labelText?: string;
        labelSize?: string;
        labelGap?: string;
        labelColor?: string;
    },
    toggleLabels?: {
        ariaLabelActive?: string;
        ariaLabelInactive?: string;
    }
};

const { id, type, class: className, label: { labelText = 'Label text', labelSize, labelGap, labelColor } = {}, toggleLabels: { ariaLabelActive = 'Show password', ariaLabelInactive = 'Hide password' } = {}, ...inputAttributes } = Astro.props;
---

<fieldset class:list={["input-field", className]} style={(labelSize || labelGap || labelColor) && { "--label-size": labelSize, "--label-gap": labelGap, "--label-color": labelColor }}>
    <legend aria-hidden="true" class="input-legend">
        <span>{labelText}</span>
    </legend>
    <input id={id} type={type} {...inputAttributes} placeholder=" " />
    <label for={id} class="input-label">{labelText}</label>
    { type === "password" && (
        <ToggleButton id={`${id}-toggle-button`} type="button" class="input-toggle" ariaLabelActive={ariaLabelActive} ariaLabelInactive={ariaLabelInactive} aria-controls={id}>
            <slot/>
        </ToggleButton>
    )}
</fieldset>

		<!-- <ToggleButton id={`signin-email-toggle-button`} type="button" class="input-toggle" aria-controls="signin-email" aria-label="Mostrar contraseña">
        			    <IconEye stroke-width="1.6" width="20" height="20" class="stroke-white hidden" data-toggle-button-active />
        			    <IconEyeSlash stroke-width="1.6" width="20" height="20" class="stroke-white" data-toggle-button-inactive/> 
        			</ToggleButton> -->

<script>
    const setupPasswordVisibility = (fieldElement: HTMLDivElement) => { 
        const passwordInput = fieldElement.querySelector<HTMLInputElement>('input[type="password"]');
        const toggleButton = fieldElement.querySelector<HTMLButtonElement>('[id$="-toggle-button"]');

        if (!passwordInput) return;

        toggleButton?.addEventListener("click", () => {
            const show = passwordInput.type === "password";
            passwordInput.type = show ? "text" : "password";
        });
    };
    
    document.querySelectorAll<HTMLDivElement>(".input-field").forEach(setupPasswordVisibility);

    //    const setupPasswordVisibility = (fieldElement: HTMLDivElement) => { 
    //     const passwordInput = fieldElement.querySelector<HTMLInputElement>('input[type="password"]');
    //     const toggleButton = fieldElement.querySelector<HTMLButtonElement>('[id$="-toggle-button"]');

    //     toggleButton?.addEventListener("toggle-button:change", (event) => {
    //         const { active } = (event as CustomEvent<{ active: boolean }>).detail;
    //         if (passwordInput) passwordInput.type = active ? "text" : "password";
    //     });
    // };
    
    // document.querySelectorAll<HTMLDivElement>(".form-field").forEach(setupPasswordVisibility);
</script>

<style>
.input-field {
    interpolate-size: allow-keywords;
    position: relative;
    min-width: 0;
    transition: border-color var(--_transition), color var(--_transition);
}

.input-field input {
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: transparent;
    outline: none;
    font: inherit;
    color: inherit;
    -webkit-text-fill-color: currentColor;
    text-overflow: ellipsis;
}

.input-legend {
    visibility: hidden;
    width: 0;
    height: 0.25rem;
    margin-left: calc(-1 * var(--label-gap));
    margin-bottom: -0.25rem;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    font-size: var(--label-size);
    line-height: 0;
    transition: width var(--_transition);
}

.input-legend span {
    padding-inline: var(--label-gap);
}

.input-label {
    position: absolute;
    top: 50%;
    inset-inline-start: 0;
    padding-inline-start: inherit;
    transform: translateY(-50%);
    pointer-events: none;
    color: inherit;
    transition: top var(--_transition), color var(--_transition), font-size var(--_transition);
}

.input-field:is(:focus-within, :has(input:is(:not(:placeholder-shown), :autofill))) {
    .input-legend { 
        width: max-content; 
    }

    .input-label { 
        top: 0;
        font-size: var(--label-size); 
    }
}

.input-field:focus-within .input-label {
    color: var(--label-color, inherit);
}

.input-toggle {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    box-sizing: content-box;
    inline-size: 0;
    block-size: 100%;
    padding: 0;
    padding-inline-end: inherit;
    cursor: pointer;
}

.input-toggle :global(svg) {
    position: absolute;
    inset: 0;
    margin: auto;
}

input:-webkit-autofill {
    transition-property: background-color, color, -webkit-text-fill-color;
    transition-duration: 5000s;
}
</style>