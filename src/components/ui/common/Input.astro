---
interface Props extends astroHTML.JSX.InputHTMLAttributes {
    id: string;
    label?: string;
    class?: string;
    labelSize?: string;
    labelGap?: string;
};

const { id, type, label, class: className, labelSize, labelGap, ...inputAttributes } = Astro.props;
---

<fieldset class:list={["input-field", className]} style={{ "--label-size": labelSize, "--label-gap": labelGap }}>
    <legend aria-hidden="true" class="input-legend">
        <span>{label}</span>
    </legend>

    <input id={id} type={type} {...inputAttributes} placeholder=" " />

    <label for={id} class="input-label">{label}</label>
</fieldset>

<style>
.input-field {
    interpolate-size: allow-keywords;
    position: relative;
    min-width: 0;
    transition: 
        border-color var(--transition-duration, 300ms) var(--transition-timing, ease-in-out), 
        color var(--transition-duration, 300ms) var(--transition-timing, ease-in-out);
}

.input-field input {
    width: 100%;
    height: var(--input-height, 3.25rem);
    border: none;
    background: transparent;
    outline: none;
    font: inherit;
    color: inherit;
    -webkit-text-fill-color: currentColor;
}

.input-legend {
    visibility: hidden;
    width: 0;
    height: 0.25rem;
    margin-left: calc(-1 * var(--label-gap));
    margin-bottom: -0.25rem;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    font-size: var(--label-size);
    line-height: 0;
    transition: width var(--transition-duration, 300ms) var(--transition-timing, ease-in-out);
}

.input-legend span {
    padding-inline: var(--label-gap);
}

.input-label {
    position: absolute;
    top: 50%;
    left: 0;
    padding-inline-start: inherit;
    transform: translateY(-50%);
    pointer-events: none;
    transition: 
        top var(--transition-duration, 300ms) var(--transition-timing, ease-in-out), 
        font-size var(--transition-duration, 300ms) var(--transition-timing, ease-in-out);
}

.input-field:is(:focus-within, :has(input:is(:not(:placeholder-shown), :autofill))) {
    .input-legend { width: max-content; }
    .input-label { top: 0; font-size: var(--label-size); }
}

input:-webkit-autofill {
    transition-property: background-color, color, -webkit-text-fill-color;
    transition-duration: 5000s;
}

/* @media (prefers-reduced-motion: reduce) {
    .input-field, .input-legend, .input-label { transition: none; }
} */
</style>



