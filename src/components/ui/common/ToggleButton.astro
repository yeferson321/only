---
interface Props extends astroHTML.JSX.ButtonHTMLAttributes {
    id: string;
    class?: string;
    defaultOn?: boolean;
    ariaLabelOn?: string;
    ariaLabelOff?: string;
};

const { id, type = "button", defaultOn = false, class: className, ariaLabelOn, ariaLabelOff, ...attributes } = Astro.props;

// Dos etiquetas distintas: cambia el aria-label. Si no, se usa aria-pressed con la etiqueta fija de `aria-label`.
const swapsLabel = Boolean(ariaLabelOn && ariaLabelOff && ariaLabelOn !== ariaLabelOff);

const initialLabel = swapsLabel ? (defaultOn ? ariaLabelOn : ariaLabelOff) : undefined;

console.log(swapsLabel, initialLabel)
---

<button id={id} type={type} class:list={["toggle-button", className]} data-toggle-button-id={id} data-state={defaultOn ? "on" : "off"} data-swaps-label={String(swapsLabel)} data-aria-label-on={ariaLabelOn} data-aria-label-off={ariaLabelOff} aria-label={initialLabel} aria-pressed={swapsLabel ? undefined : defaultOn ? "true" : "false"} {...attributes}>        
    <slot />
</button>

<script>
    const setupToggleButton = (buttonElement: HTMLButtonElement) => {
        const { toggleButtonId, swapsLabel, ariaLabelOn = "", ariaLabelOff = "" } = buttonElement.dataset;

        if (!toggleButtonId) throw new Error('Missing "data-toggle-button-id" attribute on ToggleButton component');

        delete buttonElement.dataset.ariaLabelOn;
        delete buttonElement.dataset.ariaLabelOff;

        const slotElements = buttonElement.querySelectorAll<HTMLElement>("[data-toggle-button-slot]");

        const setAccessibility = (isOn: boolean) => {
            if (swapsLabel === "true") buttonElement.setAttribute("aria-label", isOn ? ariaLabelOn : ariaLabelOff);
            else buttonElement.setAttribute("aria-pressed", String(isOn));
        };

        const setState = (nextIsOn: boolean) => {
            const nextState = nextIsOn ? "on" : "off";
            if (buttonElement.dataset.state === nextState) return;

            buttonElement.dataset.state = nextState;
            setAccessibility(nextIsOn);
            slotElements.forEach((element) => element.classList.toggle("hidden"));

            buttonElement.dispatchEvent(new CustomEvent("toggle-button:change", { detail: { isOn: nextIsOn }, bubbles: true }));
        };

        const toggle = () => setState(buttonElement.dataset.state !== "on");

        buttonElement.addEventListener("click", toggle);
        window.addEventListener(`toggle-button:toggle:${toggleButtonId}`, toggle);
        window.addEventListener(`toggle-button:turnon:${toggleButtonId}`, () => setState(true));
        window.addEventListener(`toggle-button:turnoff:${toggleButtonId}`, () => setState(false));
    };

    document.querySelectorAll<HTMLButtonElement>(".toggle-button").forEach(setupToggleButton);
</script>