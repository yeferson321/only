---
interface Props extends astroHTML.JSX.ButtonHTMLAttributes {
    id: string;
    class?: string;
    ariaLabelVisible?: string;
    ariaLabelHidden?: string;
};

const { id, type = "button", class: className, ariaLabelVisible, ariaLabelHidden, ...attributes } = Astro.props;
---

<button id={id} type={type} class:list={["toggle-button", className]} data-toggle-button-id={id} data-state="false" data-aria-label-visible={ariaLabelVisible} data-aria-label-hidden={ariaLabelHidden} aria-label={ariaLabelVisible} {...attributes}>
    <slot />
</button>

<script>
    const ARIA_STATE_ATTRIBUTES = ["aria-pressed", "aria-busy"];

    const setupToggleButton = (buttonElement: HTMLButtonElement) => {
        const { toggleButtonId, ariaLabelVisible = "", ariaLabelHidden = "" } = buttonElement.dataset;
        if (!toggleButtonId) throw new Error('Missing "data-toggle-button-id" attribute on ToggleButton component');

        const slotElements = buttonElement.querySelectorAll<HTMLElement>("[data-toggle-button-slot]");

        delete buttonElement.dataset.ariaLabelVisible;
        delete buttonElement.dataset.ariaLabelHidden;

        const hasLabels = Boolean(ariaLabelVisible && ariaLabelHidden);
        const ariaStateNames = ARIA_STATE_ATTRIBUTES.filter((name) => buttonElement.hasAttribute(name));
            
        const setAccessibility = (isPressed: boolean) => {
            if (hasLabels) buttonElement.setAttribute("aria-label", isPressed ? ariaLabelHidden : ariaLabelVisible);
            ariaStateNames.forEach((name) => buttonElement.setAttribute(name, String(isPressed)));
        };

        const toggleVisibility = (nextIsPressed: boolean) => {
            if (buttonElement.dataset.state === String(nextIsPressed)) return;

            buttonElement.dataset.state = String(nextIsPressed);

            setAccessibility(nextIsPressed);

            slotElements.forEach((element) => element.dataset.toggleButtonSlot = element.dataset.toggleButtonSlot === "visible" ? "hidden" : "visible");

            buttonElement.dispatchEvent(new CustomEvent("toggle-button:change", { detail: { state: nextIsPressed }, bubbles: true }));
        };

        const toggle = () => toggleVisibility(buttonElement.dataset.state !== "true");

        buttonElement.addEventListener("click", toggle);
        // window.addEventListener(`toggle-button:toggle:${toggleButtonId}`, toggle);
        window.addEventListener(`toggle-button:press:${toggleButtonId}`, () => toggleVisibility(true));
        window.addEventListener(`toggle-button:release:${toggleButtonId}`, () => toggleVisibility(false));
    };

    document.querySelectorAll<HTMLButtonElement>(".toggle-button").forEach(setupToggleButton);
</script>

<style>
.toggle-button :global([data-toggle-button-slot="hidden"]) {
    display: none;
}
</style>