---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
import Modal from './ui/common/Modal.astro';

const count = 4; // prueba con 0, 500, 3000 y 10000
const items = Array.from({ length: count }, (_, i) => i);
---

<button type="button" class="p-2.5 rounded-full bg-blue-500/20 hover:bg-blue-500/30 transition-colors duration-300 ease-in-out" data-modal-open="welcome-modal" aria-label="Abrir modal de inicio de sesión" aria-haspopup="dialog" aria-expanded="false" aria-controls="welcome-modal">
	Abrir Modal
</button>

<Modal id="welcome-modal" verticalPosition="center" overlayColor="rgba(0,0,0,0.5)" offset="2rem" unmount={false}>
	<div class="content">
		<h2 id="welcome-modal-title">Welcome to Astro!</h2>
    	<p>This is a simple modal component.</p>

		    <div style="background: white; padding: 1rem; max-width: 40rem;">
        <h2 id="test-modal-title">Prueba de carga</h2>
        {items.map((i) => (
            <div class="item" style="padding: .5rem; margin: .25rem 0; border-radius: .5rem; box-shadow: 0 4px 12px rgb(0 0 0 / .25);">
                <button>Elemento {i}</button>
                <span>Texto de ejemplo para ocupar espacio</span>
            </div>
        ))}
    </div>
	</div>
</Modal>

<style>
	.content {
		padding: 2rem;
		background-color: white;
		border-radius: 0.5rem;
		box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
	}

	 .item {
        content-visibility: auto;
        contain-intrinsic-size: auto 3.5rem;
    }
</style>